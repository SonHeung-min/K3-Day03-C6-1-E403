flowchart TD
    A["User query"] --> B{"Có cần dữ liệu hồ sơ hoặc tool không?"}

    B -->|"Không: lời khuyên chung / icebreaker"| C["Chatbot Baseline"]
    C --> D["Final Answer trực tiếp, không Thought/Action"]

    B -->|"Có: tìm hồ sơ / phân tích tương thích / gợi ý cá nhân hóa"| E["Cupid ReAct Agent"]
    E --> F{"Loại nhu cầu"}

    F -->|"Tìm ứng viên theo tiêu chí"| G["Action: search_profiles[...]"]
    F -->|"Hai người cụ thể"| H["Action: analyze_compatibility[...]"]
    F -->|"Kiểm tra điểm loại trừ"| I["Action: check_dealbreakers[...]"]

    G --> J["Observation"]
    H -->
    I --> J

    J --> K{"Observation đủ và không lỗi?"}
    K -->|"Có"| L{"Cần gợi ý tiếp?"}
    L -->|"Chủ đề trò chuyện"| M["Action: suggest_conversation_topics[...]"]
    L -->|"Buổi hẹn"| N["Action: suggest_date_idea[...]"]
    L -->|"Không"| O["Final Answer dựa trên Observation"]

    M --> O
    N --> O

    K -->|"Không / count=0 / LỖI"| P["Safe fallback: không bịa, đề xuất bổ sung dữ liệu hoặc nới tiêu chí"]

    E --> Q{"Chạm MAX_ITERATIONS?"}
    Q -->|"Có"| P
